// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String

  role Role

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  isActive        Boolean @default(true)
  currentDeviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mr        MR?
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WAREHOUSE_MANAGER
  ACCOUNTANT
  DISTRIBUTOR
  RETAILER
  MEDICAL_REPRESENTATIVE
}

model Company {
  id Int @id @default(autoincrement())

  name    String
  email   String?
  phone   String?
  address String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  branches   Branch[]
  warehouses Warehouse[]

  rolePermissions RolePermission[]

  permissions CompanyFeaturePermission[]

  products Product[]
}

model Branch {
  id Int @id @default(autoincrement())

  name String
  code String?

  address String?
  city    String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  users User[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features Feature[]
}

model Feature {
  id Int @id @default(autoincrement())

  name        String
  description String?

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  permissions CompanyFeaturePermission[]
}

model CompanyFeaturePermission {
  id Int @id @default(autoincrement())

  companyId Int
  featureId Int

  enabled Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, featureId])
}

model RolePermission {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  role Role

  featureId Int
  feature   Feature @relation(fields: [featureId], references: [id])

  createdAt DateTime @default(now())
}

model ProductCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  hsnCode String?
  gst     Float?

  mrp Float
  ptr Float?
  pts Float?
  ptd Float?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  minStock Int

  genericName    String?
  brandName      String?
  type           String?
  manufacturer   String?
  composition    String?
  scheme         String?
  packingType    String?
  unitsPerPack   String?
  packsInBox     String?
  totalUnits     String?
  purchasePrice  Float?
  sellingPrice   Float?
  reorderLevel   Int?
  batchTracking  Boolean @default(false)
  expiryTracking Boolean @default(false)
  status         String  @default("Active")

  batches Batch[]

  invoiceItems InvoiceItem[]

  retailerOrderItems RetailerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inwardStockItems       InwardStockItem[]
  outwardStockItems      OutwardStockItem[]
  warehouseTransferItems WarehouseTransferItem[]
  pricingMasters         PricingMaster[]
  schemeMasters          SchemeMaster[]
}

model Batch {
  id Int @id @default(autoincrement())

  batchNumber String

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  manufacturingDate DateTime
  expiryDate        DateTime

  quantity Int

  inventories            Inventory[]
  warehouseTransferItems WarehouseTransferItem[]
  dispatches             Dispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outwardStockItems OutwardStockItem[]
  pricingMasters    PricingMaster[]
  schemeMasters     SchemeMaster[]
}

model Inventory {
  id Int @id @default(autoincrement())

  batchId     Int
  warehouseId Int
  quantity    Int

  batch Batch @relation(fields: [batchId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  stockMovements StockMovement[]
}

model Warehouse {
  id Int @id @default(autoincrement())

  name    String
  code    String  @unique
  address String?

  type          String  @default("Main Warehouse")
  branch        String  @default("Default Branch")
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  state         String?
  country       String?
  pinCode       String?
  gstNumber     String?
  licenseNumber String?
  remarks       String?
  status        String  @default("Active")
  createdBy     String  @default("System")

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  inventories Inventory[]

  dispatches Dispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inwardStocks  InwardStock[]
  outwardStocks OutwardStock[]
}

model StockMovement {
  id Int @id @default(autoincrement())

  inventoryId Int

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  movementType String

  quantity Int

  remarks String?

  createdAt DateTime @default(now())
}

model WarehouseTransfer {
  id              Int                     @id @default(autoincrement())
  transferNo      String                  @unique
  date            DateTime                @default(now())
  fromWarehouseId Int
  toWarehouseId   Int
  status          String                  @default("Completed")
  itemsCount      Int                     @default(0)
  totalQuantity   Int                     @default(0)
  remarks         String?
  items           WarehouseTransferItem[]
  createdAt       DateTime                @default(now())
}

model WarehouseTransferItem {
  id                  Int               @id @default(autoincrement())
  warehouseTransferId Int
  warehouseTransfer   WarehouseTransfer @relation(fields: [warehouseTransferId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product           @relation(fields: [productId], references: [id])
  batchId             Int
  batch               Batch             @relation(fields: [batchId], references: [id])
  quantity            Int
  createdAt           DateTime          @default(now())
}

model Dispatch {
  id Int @id @default(autoincrement())

  batchId Int?
  batch   Batch? @relation(fields: [batchId], references: [id])

  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  customerName String?

  quantity Int?

  dispatchDate DateTime @default(now())

  status String @default("PENDING")

  remarks String?

  dispatchNo      String?
  dispatchType    String?
  orderId         String?
  sourceWarehouse String?
  totalItems      Int?
  totalQuantity   Int?
  transporter     String?
  lrNumber        String?
  vehicleNumber   String?
  driverName      String?
  driverMobile    String?
  createdBy       String?
  createdDate     String?
  products        Json?

  transportChallans TransportChallan[]

  createdAt DateTime @default(now())
}

model TransportChallan {
  id Int @id @default(autoincrement())

  dispatchId Int?

  dispatch Dispatch? @relation(fields: [dispatchId], references: [id])

  transporterName String?

  vehicleNumber String?

  driverName String?

  driverMobile String?

  challanNumber String? @unique

  dispatchNo         String?
  challanNo          String?
  challanDate        String?
  dispatchDate       String?
  orderNo            String?
  customer           String?
  sourceWarehouse    String?
  totalItems         Int?
  totalQty           Int?
  status             String?
  products           Json?
  createdBy          String?
  createdDate        String?
  podStatus          String?
  podUploadedBy      String?
  podUploadedDate    String?
  podReceivedBy      String?
  podDesignation     String?
  podFileUrl         String?
  podFileName        String?
  podFileType        String?
  podRemarks         String?
  actualDeliveryDate String?

  lrTrackings LRTracking[]

  createdAt DateTime @default(now())
}

model LRTracking {
  id Int @id @default(autoincrement())

  transportChallanId Int

  transportChallan TransportChallan @relation(fields: [transportChallanId], references: [id])

  lrNumber String @unique

  source String

  destination String

  status String @default("IN_TRANSIT")

  deliveryTrackings DeliveryTracking[]

  createdAt DateTime @default(now())
}

model DeliveryTracking {
  id Int @id @default(autoincrement())

  lrTrackingId Int

  lrTracking LRTracking @relation(fields: [lrTrackingId], references: [id])

  receiverName String

  receiverMobile String?

  deliveryDate DateTime @default(now())

  status String @default("DELIVERED")

  remarks String?

  createdAt DateTime @default(now())
}

model Stockist {
  id Int @id @default(autoincrement())

  name String

  code String? @unique

  mobile String

  email String?

  address String?

  gstNumber String?

  drugLicenseNumber String?

  isActive Boolean @default(true)

  retailers Retailer[]

  meetingStockists MeetingStockist[]

  createdAt DateTime @default(now())
}

model Retailer {
  id Int @id @default(autoincrement())

  stockistId Int

  stockist Stockist @relation(fields: [stockistId], references: [id])

  name String

  code String @unique

  mobile String

  email String?

  address String?

  gstNumber String?

  drugLicenseNumber String?

  invoices Invoice[]

  orders RetailerOrder[]

  ledgers Ledger[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model Invoice {
  id Int @id @default(autoincrement())

  retailerId Int

  retailer Retailer @relation(fields: [retailerId], references: [id])

  invoiceNumber String @unique

  invoiceDate DateTime @default(now())

  subTotal Float

  gstAmount Float

  totalAmount Float

  status String @default("PENDING")

  invoiceItems InvoiceItem[]

  paymentCollections PaymentCollection[]

  createdAt DateTime @default(now())
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  productId Int

  product Product @relation(fields: [productId], references: [id])

  quantity Int

  rate Float

  gst Float

  amount Float
}

model RetailerOrder {
  id         Int  @id @default(autoincrement())
  retailerId Int
  mrId       Int?

  retailer Retailer @relation(fields: [retailerId], references: [id])
  mr       MR?      @relation(fields: [mrId], references: [id])

  orderNumber String   @unique
  orderDate   DateTime @default(now())

  totalAmount Float

  status String @default("PENDING")

  orderItems RetailerOrderItem[]

  createdAt DateTime @default(now())
}

model RetailerOrderItem {
  id Int @id @default(autoincrement())

  retailerOrderId Int

  retailerOrder RetailerOrder @relation(fields: [retailerOrderId], references: [id])

  productId Int

  product Product @relation(fields: [productId], references: [id])

  quantity Int

  rate Float

  amount Float
}

model PaymentCollection {
  id Int @id @default(autoincrement())

  invoiceId Int

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  paymentMode String

  transactionRef String?

  paymentDate DateTime @default(now())

  remarks String?

  createdAt DateTime @default(now())
}

model Ledger {
  id Int @id @default(autoincrement())

  retailerId Int

  retailer Retailer @relation(fields: [retailerId], references: [id])

  transactionType String

  referenceNumber String

  debit Float @default(0)

  credit Float @default(0)

  balance Float

  remarks String?

  createdAt DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  expenseType String
  amount      Float
  remarks     String?
  expenseDate DateTime @default(now())
}

model Income {
  id         Int      @id @default(autoincrement())
  incomeType String
  amount     Float
  remarks    String?
  incomeDate DateTime @default(now())
}

model MR {
  id Int @id @default(autoincrement())

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  mrCode String @unique

  name String

  mobile String

  email String?

  territory String?

  joiningDate DateTime @default(now())

  status String @default("ACTIVE")

  attendances Attendance[]

  doctorVisits DoctorVisit[]

  chemistVisits ChemistVisit[]

  targets        Target[]
  tourPlans      TourPlan[]
  dailyReports   DailyReport[]
  meetings       Meeting[]
  followUps      FollowUp[]
  activities     Activity[]
  assignedLeads  Lead[]
  leaveRequests  LeaveRequest[]
  expenseClaims  ExpenseClaim[]
  notifications  Notification[]
  retailerOrders RetailerOrder[]

  createdAt DateTime @default(now())
}

model Doctor {
  id Int @id @default(autoincrement())

  doctorCode String @unique

  name String

  specialization String?

  hospital String?

  mobile String?

  email String?

  address String?

  territory String?

  isActive Boolean @default(true)

  doctorVisits DoctorVisit[]

  meetingDoctors MeetingDoctor[]
  followUps      FollowUp[]

  createdAt DateTime @default(now())

  tourPlanDoctors TourPlanDoctor[]
  meetings        Meeting[]        @relation("DoctorDirectMeetings")
}

model Chemist {
  id Int @id @default(autoincrement())

  chemistCode String @unique

  name String

  mobile String?

  email String?

  address String?

  territory String?

  gstNumber String?

  drugLicenseNumber String?

  isActive Boolean @default(true)

  chemistVisits ChemistVisit[]

  meetingChemists MeetingChemist[]
  followUps       FollowUp[]

  createdAt        DateTime          @default(now())
  tourPlanChemists TourPlanChemist[]
  meetings         Meeting[]         @relation("ChemistDirectMeetings")
}

model Attendance {
  id Int @id @default(autoincrement())

  mrId Int

  mr MR @relation(fields: [mrId], references: [id])

  attendanceDate DateTime @default(now())

  checkInTime DateTime?

  checkOutTime DateTime?

  checkInLatitude Float?

  checkInLongitude Float?

  checkOutLatitude Float?

  checkOutLongitude Float?

  status String @default("PRESENT")

  createdAt DateTime @default(now())
}

model DoctorVisit {
  id Int @id @default(autoincrement())

  mrId Int

  doctorId Int

  visitDate DateTime @default(now())

  remarks String?

  productsDiscussed String?

  samplesGiven Int?

  latitude Float?

  longitude Float?

  mr MR @relation(fields: [mrId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
}

model ChemistVisit {
  id Int @id @default(autoincrement())

  mrId Int

  chemistId Int

  visitDate DateTime @default(now())

  remarks String?

  productsDiscussed String?

  orderValue Float?

  latitude Float?

  longitude Float?

  mr MR @relation(fields: [mrId], references: [id])

  chemist Chemist @relation(fields: [chemistId], references: [id])

  createdAt DateTime @default(now())
}

model TourPlan {
  id Int @id @default(autoincrement())

  mrId Int

  tourDate DateTime

  territory String

  objective String?

  status String @default("PLANNED")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])

  tourPlanDoctors  TourPlanDoctor[]
  tourPlanChemists TourPlanChemist[]
}

model TourPlanDoctor {
  id Int @id @default(autoincrement())

  tourPlanId Int

  doctorId Int

  tourPlan TourPlan @relation(fields: [tourPlanId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model TourPlanChemist {
  id Int @id @default(autoincrement())

  tourPlanId Int

  chemistId Int

  tourPlan TourPlan @relation(fields: [tourPlanId], references: [id])

  chemist Chemist @relation(fields: [chemistId], references: [id])
}

model DailyReport {
  id Int @id @default(autoincrement())

  mrId Int

  reportDate DateTime

  doctorVisits Int @default(0)

  chemistVisits Int @default(0)

  samplesDistributed Int @default(0)

  ordersCollected Decimal @default(0)

  remarks String?

  status String @default("SUBMITTED")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model Target {
  id Int @id @default(autoincrement())

  mrId Int

  month Int

  year Int

  doctorVisitTarget Int

  chemistVisitTarget Int

  orderTarget Decimal @default(0)

  achievedDoctorVisits Int @default(0)

  achievedChemistVisits Int @default(0)

  achievedOrderValue Decimal @default(0)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model Meeting {
  id Int @id @default(autoincrement())

  mrId Int

  doctorId Int?

  chemistId Int?

  title String

  description String?

  meetingDate DateTime

  location String?

  status String @default("SCHEDULED")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])

  doctor Doctor? @relation("DoctorDirectMeetings", fields: [doctorId], references: [id])

  chemist          Chemist?          @relation("ChemistDirectMeetings", fields: [chemistId], references: [id])
  meetingDoctors   MeetingDoctor[]
  meetingChemists  MeetingChemist[]
  meetingHospitals MeetingHospital[]
  meetingStockists MeetingStockist[]
  followUps        FollowUp[]
}

model MeetingDoctor {
  id Int @id @default(autoincrement())

  meetingId Int

  doctorId Int

  meeting Meeting @relation(fields: [meetingId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model MeetingChemist {
  id Int @id @default(autoincrement())

  meetingId Int

  chemistId Int

  meeting Meeting @relation(fields: [meetingId], references: [id])

  chemist Chemist @relation(fields: [chemistId], references: [id])
}

model MeetingHospital {
  id Int @id @default(autoincrement())

  meetingId Int

  hospitalId Int

  meeting Meeting @relation(fields: [meetingId], references: [id])

  hospital Hospital @relation(fields: [hospitalId], references: [id])
}

model MeetingStockist {
  id Int @id @default(autoincrement())

  meetingId Int

  stockistId Int

  meeting Meeting @relation(fields: [meetingId], references: [id])

  stockist Stockist @relation(fields: [stockistId], references: [id])
}

model FollowUp {
  id Int @id @default(autoincrement())

  mrId Int

  doctorId Int?

  chemistId Int?

  meetingId Int?

  title String

  remarks String?

  followUpDate DateTime

  status String @default("PENDING")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])

  doctor Doctor? @relation(fields: [doctorId], references: [id])

  chemist Chemist? @relation(fields: [chemistId], references: [id])

  meeting Meeting? @relation(fields: [meetingId], references: [id])
}

model Activity {
  id Int @id @default(autoincrement())

  mrId Int

  activityType String

  title String

  description String?

  activityDate DateTime

  status String @default("PENDING")

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model Lead {
  id Int @id @default(autoincrement())

  leadCode String @unique

  name String

  type String

  mobile String?

  email String?

  address String?

  territory String?

  source String?

  status String @default("NEW")

  assignedMrId Int?

  createdAt DateTime @default(now())

  assignedMr MR? @relation(fields: [assignedMrId], references: [id])
}

model LeaveRequest {
  id Int @id @default(autoincrement())

  mrId Int

  leaveType String

  fromDate DateTime

  toDate DateTime

  reason String?

  status String @default("PENDING")

  appliedAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model ExpenseClaim {
  id Int @id @default(autoincrement())

  mrId Int

  expenseType String

  amount Decimal

  expenseDate DateTime

  description String?

  receiptUrl String?

  status String @default("PENDING")

  submittedAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model Notification {
  id Int @id @default(autoincrement())

  mrId Int

  title String

  message String

  type String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  mr MR @relation(fields: [mrId], references: [id])
}

model Distributor {
  id     Int    @id @default(autoincrement())
  name   String
  mobile String
}

model Hospital {
  id               Int               @id @default(autoincrement())
  name             String
  mobile           String?
  address          String?
  meetingHospitals MeetingHospital[]
}

model TerritoryBeat {
  id            Int    @id @default(autoincrement())
  area          String
  district      String
  state         String
  totalDoctors  Int
  totalChemists Int
}

model Supplier {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  contact      String?
  email        String?
  address      String?
  inwardStocks InwardStock[]
  createdAt    DateTime      @default(now())
}

model InwardStock {
  id            Int               @id @default(autoincrement())
  grnNo         String            @unique
  date          DateTime          @default(now())
  supplierId    Int
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  warehouseId   Int
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  invoiceNumber String?
  invoiceDate   DateTime?
  itemsCount    Int               @default(0)
  totalQuantity Int               @default(0)
  totalValue    Float             @default(0.0)
  status        String            @default("Completed")
  remarks       String?
  items         InwardStockItem[]
  createdAt     DateTime          @default(now())
}

model InwardStockItem {
  id            Int         @id @default(autoincrement())
  inwardStockId Int
  inwardStock   InwardStock @relation(fields: [inwardStockId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  batchNo       String
  mfgDate       DateTime?
  expiryDate    DateTime?
  quantity      Int
  ptr           Float       @default(0.0)
  mrp           Float       @default(0.0)
  createdAt     DateTime    @default(now())
}

model OutwardStock {
  id              Int                @id @default(autoincrement())
  dispatchNo      String             @unique
  date            DateTime           @default(now())
  client          String
  warehouseId     Int
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  referenceNumber String?
  itemsCount      Int                @default(0)
  totalQuantity   Int                @default(0)
  totalValue      Float              @default(0.0)
  status          String             @default("Dispatched")
  remarks         String?
  items           OutwardStockItem[]
  createdAt       DateTime           @default(now())
}

model OutwardStockItem {
  id             Int          @id @default(autoincrement())
  outwardStockId Int
  outwardStock   OutwardStock @relation(fields: [outwardStockId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  batchId        Int
  batch          Batch        @relation(fields: [batchId], references: [id])
  quantity       Int
  rate           Float        @default(0.0)
}

model HSNCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  status      String   @default("Active")
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GSTRecord {
  id            Int       @id @default(autoincrement())
  hsnCode       String
  description   String
  gstPercent    Float
  effectiveDate DateTime?
  createdBy     String?
  lastUpdatedBy String?
  status        String    @default("Active")
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PackingType {
  id          Int      @id @default(autoincrement())
  name        String   @default("")
  code        String   @unique
  uom         String   @default("")
  description String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingMaster {
  id            Int       @id @default(autoincrement())
  productId     Int
  product       Product   @relation(fields: [productId], references: [id])
  mrp           Float
  ptr           Float
  pts           Float
  margin        Float
  effectiveDate DateTime?
  status        String    @default("Active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  batch         Batch?    @relation(fields: [batchId], references: [id])
  batchId       Int?
}

model SchemeMaster {
  id                  Int       @id @default(autoincrement())
  code                String    @unique
  name                String
  type                String    @default("Quantity Discount")
  applicableTo        String    @default("All Products")
  applicableSelection String    @default("")
  productId           Int?
  product             Product?  @relation(fields: [productId], references: [id])
  benefitType         String    @default("Free Quantity")
  benefitValue        String?
  buyQty              Int
  freeQty             Int
  startDate           DateTime?
  endDate             DateTime?
  remarks             String?
  status              String    @default("Active")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  batch               Batch?    @relation(fields: [batchId], references: [id])
  batchId             Int?
}
